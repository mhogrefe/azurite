# Lean 4 Cache and Build Output
/.lake
*.olean
*.ilean

# OS specific files
.DS_Store
.AppleDouble
.LSOverride

# Editor directories
.vscode/
.antigravity/
.history/

# Rust build output
benchmark-charts/target/

# Benchmark results and generated charts
benchmark-results*.txt
chart*.svg

# Blueprint generated outputs
/blueprint/print/
/blueprint/web/
/blueprint/lean_decls
*.paux

# Asymptote diagram outputs (sources are tracked; PDFs and SVGs are regenerated)
/blueprint/src/asymptote/*.pdf
/blueprint/src/asymptote/*.svg

# Claude Code session-local state (memory lives in ~/.claude, never in-repo)
.claude/projects/
.claude/settings.local.json

# The blueprint is developed locally and is not yet published; the whole
# directory is untracked until it is ready for public viewing.
/blueprint/

# Claude Code session-local files
.claude/*.lock
