/-- The residual identity (degree-106 polynomial identity, checked by `ring`). -/
theorem zero_poly_identity (t : ℝ) :
    let δ := zeroDelta t
    let E := 1 + t * δ
    (t * E ^ 7 - 2 * t ^ 3 * E ^ 5 + 24 * t ^ 5 * E ^ 3 - 720 * t ^ 7 * E) *
        (δ - δ ^ 3 / 6 + δ ^ 5 / 120 - δ ^ 7 / 5040) -
      (t ^ 2 * E ^ 6 - 6 * t ^ 4 * E ^ 4 + 120 * t ^ 6 * E ^ 2 - 5040 * t ^ 8) *
        (1 - δ ^ 2 / 2 + δ ^ 4 / 24 - δ ^ 6 / 720) = t ^ 10 * zeroPolyR t := by
  intro δ E
  simp only [δ, E, zeroDelta, zeroPolyR]
  ring

