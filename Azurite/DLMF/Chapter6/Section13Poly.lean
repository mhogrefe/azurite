theorem zeroPolyR_eq_horner (t : ℝ) : zeroPolyR t = hornerR zeroCoeffs t := by
  simp only [zeroPolyR, hornerR, zeroCoeffs]
  ring

theorem abs_hornerR_le {t : ℝ} (ht : 0 ≤ t) :
    ∀ {L D : List ℝ}, List.Forall₂ (fun c d => |c| ≤ d) L D → |hornerR L t| ≤ hornerR D t
  | [], [], _ => by simp [hornerR]
  | c :: cs, d :: ds, h => by
    rw [List.forall₂_cons] at h
    simp only [hornerR]
    refine (abs_add_le _ _).trans ?_
    rw [abs_mul, abs_of_nonneg ht]
    have := abs_hornerR_le ht h.2
    gcongr
    exact h.1

theorem hornerR_mono {t s : ℝ} (ht : 0 ≤ t) (hts : t ≤ s) :
    ∀ {D : List ℝ}, (∀ d ∈ D, 0 ≤ d) → hornerR D t ≤ hornerR D s
  | [], _ => by simp [hornerR]
  | d :: ds, h => by
    simp only [hornerR]
    have hn : 0 ≤ hornerR ds t := hornerR_nonneg ht fun e he => h e (List.mem_cons_of_mem _ he)
    have := hornerR_mono ht hts fun e he => h e (List.mem_cons_of_mem _ he)
    nlinarith
where
  hornerR_nonneg {t : ℝ} (ht : 0 ≤ t) : ∀ {D : List ℝ}, (∀ d ∈ D, 0 ≤ d) → 0 ≤ hornerR D t
    | [], _ => by simp [hornerR]
    | d :: ds, h => by
      simp only [hornerR]
      have := hornerR_nonneg ht fun e he => h e (List.mem_cons_of_mem _ he)
      have := h d List.mem_cons_self
      positivity

/-- `|zeroPolyR(t)| ≤ 31627` on `[0, 1/100]` (the constant term is `−31618.89…`). -/
theorem abs_zeroPolyR_le {t : ℝ} (ht0 : 0 ≤ t) (ht1 : t ≤ 1 / 100) : |zeroPolyR t| ≤ 31627 := by
  have hF : List.Forall₂ (fun c d => |c| ≤ d) zeroCoeffs zeroCoeffsAbs := by
    simp only [zeroCoeffs, zeroCoeffsAbs, List.forall₂_cons, List.Forall₂.nil, and_true]
    norm_num [abs_div]
  have hN : ∀ d ∈ zeroCoeffsAbs, 0 ≤ d := by
    simp only [zeroCoeffsAbs, List.forall_mem_cons, List.not_mem_nil, IsEmpty.forall_iff,
      implies_true, and_true]
    norm_num
  rw [zeroPolyR_eq_horner]
  refine (abs_hornerR_le ht0 hF).trans ((hornerR_mono ht0 ht1 hN).trans ?_)
  simp only [zeroCoeffsAbs, hornerR]
  norm_num

