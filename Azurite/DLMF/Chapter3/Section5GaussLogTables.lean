import Azurite.DLMF.Chapter3.Section5GaussLog

/-!
# DLMF §3.5(v): Tables 3.5.14–3.5.17 (Gauss nodes and weights for `ln(1/x)`)

Every number in Tables 3.5.14–3.5.17 (`n = 5, 10, 15, 20`) is certified by exact rational
arithmetic, checked by the kernel (`decide +kernel`); all entries are correctly rounded.

* `logRaw`/`logData`: `p_0, …, p_20` with rational coefficients; `logData_ok` (`logOKs`) checks
  that each is monic of the right degree, orthogonal to all lower powers for `ln(1/x)` on `(0, 1)`,
  and has `γ_m > 0`.
* `qAbs`, `qLip` (`abs_qEvalR_le`, `qEvalR_lip`) and `logKq` (`logGR_lip`): Lipschitz bounds on
  `[−1, 1]` for `∑_{j<n} p_j²/γ_j` (`logGq`, `logGR`, `sum_logMonic_eq`).
* `logRowOK`/`logRowOK_sound`: a sign change of `p_n` across a bracket `(a/D, (a+1)/D)`, the
  bracket inside the rounding interval of the printed node, and `1/∑_{j<n} p_j²/γ_j` inside that
  of the printed weight.
* `logNodes`, `logWeight` (`card_logNodes`, `mem_logNodes_iff`, `logWeight_eq`), `LogTableSpec`,
  and `logTableOK_sound` (completeness: `n` disjoint brackets give all `n` nodes).
* Tables 3.5.14–3.5.17: `dlmf_table_3_5_14` … `dlmf_table_3_5_17` (`D = 10^100`).
-/

open Polynomial Finset Set Real

namespace Azurite.DLMF

/-! ### Bounds on `[−1, 1]` -/

/-- `∑ᵢ |cᵢ|`, a bound for `|∑ᵢ cᵢ xⁱ|` on `[−1, 1]`. -/
def qAbs : List ℚ → ℚ
  | [] => 0
  | c :: l => |c| + qAbs l

/-- A Lipschitz constant for `∑ᵢ cᵢ xⁱ` on `[−1, 1]`. -/
def qLip : List ℚ → ℚ
  | [] => 0
  | _ :: l => qLip l + qAbs l

theorem qAbs_nonneg (l : List ℚ) : 0 ≤ qAbs l := by
  induction l with
  | nil => simp [qAbs]
  | cons c l ih => simp only [qAbs]; positivity

theorem qLip_nonneg (l : List ℚ) : 0 ≤ qLip l := by
  induction l with
  | nil => simp [qLip]
  | cons c l ih => simp only [qLip]; have := qAbs_nonneg l; linarith

theorem abs_qEvalR_le (l : List ℚ) {x : ℝ} (hx : |x| ≤ 1) : |qEvalR l x| ≤ (qAbs l : ℝ) := by
  induction l with
  | nil => simp [qEvalR, qAbs]
  | cons c l ih =>
    simp only [qEvalR, qAbs, Rat.cast_add, Rat.cast_abs]
    calc |(c : ℝ) + x * qEvalR l x| ≤ |(c : ℝ)| + |x| * |qEvalR l x| := by
          rw [← abs_mul]; exact abs_add_le _ _
      _ ≤ |(c : ℝ)| + 1 * (qAbs l : ℝ) := by gcongr
      _ = _ := by ring

theorem qEvalR_lip (l : List ℚ) {x y : ℝ} (hx : |x| ≤ 1) (hy : |y| ≤ 1) :
    |qEvalR l x - qEvalR l y| ≤ (qLip l : ℝ) * |x - y| := by
  induction l with
  | nil => simp [qEvalR, qLip]
  | cons c l ih =>
    simp only [qEvalR, qLip, Rat.cast_add]
    have hA := abs_qEvalR_le l hy
    calc |(c : ℝ) + x * qEvalR l x - (c + y * qEvalR l y)|
        = |x * (qEvalR l x - qEvalR l y) + (x - y) * qEvalR l y| := by congr 1; ring
      _ ≤ |x| * |qEvalR l x - qEvalR l y| + |x - y| * |qEvalR l y| := by
          rw [← abs_mul, ← abs_mul]; exact abs_add_le _ _
      _ ≤ 1 * ((qLip l : ℝ) * |x - y|) + |x - y| * (qAbs l : ℝ) := by gcongr
      _ = _ := by ring

/-! ### The Christoffel sum `∑_j p_j(x)²/γ_j` -/

/-- `∑_{l} q_l(x)²/γ_l` in `ℚ`, `γ_l = logMom l (deg l)`. -/
def logGq : List (List ℚ) → ℚ → ℚ
  | [], _ => 0
  | l :: ps, x => qEval l x ^ 2 / logMom l (l.length - 1) + logGq ps x

/-- The real version of `logGq`. -/
noncomputable def logGR : List (List ℚ) → ℝ → ℝ
  | [], _ => 0
  | l :: ps, x => qEvalR l x ^ 2 / (logMom l (l.length - 1) : ℝ) + logGR ps x

/-- A Lipschitz constant for `logGR` on `[−1, 1]`. -/
def logKq : List (List ℚ) → ℚ
  | [] => 0
  | l :: ps => 2 * qAbs l * qLip l / logMom l (l.length - 1) + logKq ps

theorem logKq_nonneg (ps : List (List ℚ)) (hpos : ∀ l ∈ ps, 0 < logMom l (l.length - 1)) :
    0 ≤ logKq ps := by
  induction ps with
  | nil => simp [logKq]
  | cons l ps ih =>
    simp only [logKq]
    have := hpos l (by simp)
    have := ih fun l' hl' => hpos l' (by simp [hl'])
    have := qAbs_nonneg l
    have := qLip_nonneg l
    positivity

theorem logGR_cast (ps : List (List ℚ)) (x : ℚ) : logGR ps x = (logGq ps x : ℝ) := by
  induction ps with
  | nil => simp [logGR, logGq]
  | cons l ps ih => simp [logGR, logGq, ih, qEvalR_cast]

theorem logGR_lip (ps : List (List ℚ)) (hpos : ∀ l ∈ ps, 0 < logMom l (l.length - 1))
    {x y : ℝ} (hx : |x| ≤ 1) (hy : |y| ≤ 1) :
    |logGR ps x - logGR ps y| ≤ (logKq ps : ℝ) * |x - y| := by
  induction ps with
  | nil => simp [logGR, logKq]
  | cons l ps ih =>
    simp only [logGR, logKq]
    have hγ : (0 : ℝ) < logMom l (l.length - 1) := by exact_mod_cast hpos l (by simp)
    have ih' := ih fun l' hl' => hpos l' (by simp [hl'])
    set γ : ℝ := ((logMom l (l.length - 1) : ℚ) : ℝ)
    set a := qEvalR l x
    set b := qEvalR l y
    have hd := qEvalR_lip l hx hy
    have hs : |a + b| ≤ 2 * (qAbs l : ℝ) := by
      have := abs_add_le a b; have := abs_qEvalR_le l hx; have := abs_qEvalR_le l hy; linarith
    have h1 : |a ^ 2 / γ - b ^ 2 / γ| ≤ 2 * (qAbs l : ℝ) * (qLip l : ℝ) / γ * |x - y| := by
      rw [← sub_div, abs_div, abs_of_pos hγ, show a ^ 2 - b ^ 2 = (a - b) * (a + b) by ring,
        abs_mul, div_mul_eq_mul_div, div_le_div_iff_of_pos_right hγ]
      calc |a - b| * |a + b| ≤ ((qLip l : ℝ) * |x - y|) * (2 * (qAbs l : ℝ)) :=
            mul_le_mul hd hs (abs_nonneg _) (by have := qLip_nonneg l; positivity)
        _ = _ := by ring
    push_cast
    calc |a ^ 2 / γ + logGR ps x - (b ^ 2 / γ + logGR ps y)|
        = |(a ^ 2 / γ - b ^ 2 / γ) + (logGR ps x - logGR ps y)| := by congr 1; ring
      _ ≤ |a ^ 2 / γ - b ^ 2 / γ| + |logGR ps x - logGR ps y| := abs_add_le _ _
      _ ≤ 2 * (qAbs l : ℝ) * (qLip l : ℝ) / γ * |x - y| + (logKq ps : ℝ) * |x - y| :=
          add_le_add h1 ih'
      _ = _ := by ring

/-! ### Certified families of orthogonal polynomials -/

/-- `logOK k l₀`, `logOK (k+1) l₁`, …: a certified run of consecutive degrees. -/
def logOKs : ℕ → List (List ℚ) → Bool
  | _, [] => true
  | k, l :: ls => logOK k l && logOKs (k + 1) ls

theorem logOKs_getD {k : ℕ} {ps : List (List ℚ)} (h : logOKs k ps = true) {j : ℕ}
    (hj : j < ps.length) : logOK (k + j) (ps.getD j []) = true := by
  induction ps generalizing k j with
  | nil => simp at hj
  | cons l ps ih =>
    simp only [logOKs, Bool.and_eq_true] at h
    rcases j with _ | j
    · simpa using h.1
    · simp only [List.getD_cons_succ]
      rw [show k + (j + 1) = k + 1 + j by ring]
      exact ih h.2 (by simpa using hj)

theorem logOKs_take {k : ℕ} {ps : List (List ℚ)} (h : logOKs k ps = true) (n : ℕ) :
    logOKs k (ps.take n) = true := by
  induction ps generalizing k n with
  | nil => simp [logOKs]
  | cons l ps ih =>
    simp only [logOKs, Bool.and_eq_true] at h
    rcases n with _ | n
    · simp [logOKs]
    · simp only [List.take_succ_cons, logOKs, Bool.and_eq_true]
      exact ⟨h.1, ih h.2 n⟩

theorem logOK_length {m : ℕ} {l : List ℚ} (h : logOK m l = true) : l.length = m + 1 := by
  simp only [logOK, Bool.and_eq_true, decide_eq_true_eq] at h
  exact h.1.1.1

theorem logOK_pos {m : ℕ} {l : List ℚ} (h : logOK m l = true) : 0 < logMom l m := by
  simp only [logOK, Bool.and_eq_true, decide_eq_true_eq] at h
  exact h.2

theorem logOKs_pos {k : ℕ} {ps : List (List ℚ)} (h : logOKs k ps = true) :
    ∀ l ∈ ps, 0 < logMom l (l.length - 1) := by
  induction ps generalizing k with
  | nil => simp
  | cons l ps ih =>
    simp only [logOKs, Bool.and_eq_true] at h
    intro l' hl'
    rcases List.mem_cons.mp hl' with rfl | hl'
    · rw [logOK_length h.1, Nat.add_sub_cancel]; exact logOK_pos h.1
    · exact ih h.2 l' hl'

theorem sum_logMonic_eq {k : ℕ} {ps : List (List ℚ)} (h : logOKs k ps = true) (x : ℝ) :
    ∑ j ∈ range ps.length, (logMonic (k + j)).eval x ^ 2 /
      gaussGamma (Ioo 0 1) logW (logMonic (k + j)) = logGR ps x := by
  induction ps generalizing k with
  | nil => simp [logGR]
  | cons l ps ih =>
    simp only [logOKs, Bool.and_eq_true] at h
    rw [List.length_cons, sum_range_succ', logGR]
    have e := ih h.2
    have e2 : ∑ j ∈ range ps.length, (logMonic (k + (j + 1))).eval x ^ 2 /
        gaussGamma (Ioo 0 1) logW (logMonic (k + (j + 1))) = logGR ps x := by
      rw [← e]; exact sum_congr rfl fun j _ => by rw [show k + (j + 1) = k + 1 + j by ring]
    rw [e2, add_zero]
    rw [logMonic_eq h.1, gaussGamma_of_logOK h.1, eval_qPoly, logOK_length h.1,
      Nat.add_sub_cancel]
    ring

/-! ### Nodes and weights -/

/-- The nodes of the `n`-point Gauss rule for `ln(1/x)` on `(0, 1)`: the zeros of `p_n`. -/
noncomputable def logNodes (n : ℕ) : Finset ℝ := (logMonic n).roots.toFinset

/-- The weights (Christoffel numbers 3.5.18). -/
noncomputable def logWeight (n : ℕ) (x : ℝ) : ℝ := christoffel (Ioo 0 1) logW (logMonic n) x

theorem card_logNodes (n : ℕ) : #(logNodes n) = n := by
  obtain ⟨hnodup, hcard, -⟩ := (isOrthMonic_logMonic n).roots_spec isGaussWeight_logW
  rw [logNodes, Multiset.toFinset_card_of_nodup hnodup, hcard]

theorem mem_logNodes_iff {n : ℕ} {pn : List ℚ} (h : logOK n pn = true) (x : ℝ) :
    x ∈ logNodes n ↔ (qPoly pn).eval x = 0 := by
  rw [logNodes, logMonic_eq h, Multiset.mem_toFinset, mem_roots (logOK_spec h).1.ne_zero,
    IsRoot.def]

theorem logWeight_eq {n : ℕ} {ps : List (List ℚ)} (h : logOKs 0 ps = true) (hlen : ps.length = n)
    {x : ℝ} (hx : x ∈ logNodes n) : logWeight n x = 1 / logGR ps x := by
  rw [logWeight, christoffel_log n hx, ← sum_logMonic_eq h, hlen]
  simp only [zero_add]

/-! ### Certified rows -/

/-- A row: the bracket `(a/D, (a + 1)/D)` of a node, the printed node `X/10^{sx}` and the printed
weight `W/10^{sw}`. -/
structure LogRow where
  a : ℕ
  X : ℕ
  sx : ℕ
  W : ℕ
  sw : ℕ

/-- The exact checks for one row (in `ℚ`): a sign change of `p_n` across the bracket, the bracket
inside the rounding interval of the printed node, and `1/∑_{j<n} p_j²/γ_j` (with the Lipschitz
error `K/D`) inside that of the printed weight. -/
def logRowOK (ps : List (List ℚ)) (pn : List ℚ) (D : ℕ) (r : LogRow) : Bool :=
  decide (0 < r.a) && decide (r.a + 1 ≤ D) &&
    decide (qEval pn ((r.a : ℚ) / D) * qEval pn (((r.a : ℚ) + 1) / D) < 0) &&
    decide ((10 * (r.X : ℤ) - 5) * D ≤ r.a * 10 ^ (r.sx + 1)) &&
    decide (((r.a : ℤ) + 1) * 10 ^ (r.sx + 1) ≤ (10 * r.X + 5) * D) && decide (0 < r.W) &&
    decide (0 < logGq ps ((r.a : ℚ) / D) - logKq ps / D) &&
    decide ((10 * (r.W : ℚ) - 5) * (logGq ps ((r.a : ℚ) / D) + logKq ps / D) ≤
      10 ^ (r.sw + 1)) &&
    decide (10 ^ (r.sw + 1) ≤
      (10 * (r.W : ℚ) + 5) * (logGq ps ((r.a : ℚ) / D) - logKq ps / D))

theorem log_abs_le_half_ulp {x X : ℝ} {d : ℕ} (h1 : (10 * X - 5) / 10 ^ (d + 1) ≤ x)
    (h2 : x ≤ (10 * X + 5) / 10 ^ (d + 1)) : |x - X / 10 ^ d| ≤ 5 / 10 ^ (d + 1) := by
  have e1 : (10 * X - 5) / 10 ^ (d + 1) = X / 10 ^ d - 5 / 10 ^ (d + 1) := by
    rw [pow_succ]; field_simp
  have e2 : (10 * X + 5) / 10 ^ (d + 1) = X / 10 ^ d + 5 / 10 ^ (d + 1) := by
    rw [pow_succ]; field_simp
  rw [abs_le]; constructor <;> linarith

theorem logRowOK_sound {ps : List (List ℚ)} {pn : List ℚ} {D : ℕ}
    (hpos : ∀ l ∈ ps, 0 < logMom l (l.length - 1)) {r : LogRow}
    (h : logRowOK ps pn D r = true) :
    ∃ x : ℝ, (r.a : ℝ) / D < x ∧ x < ((r.a : ℝ) + 1) / D ∧ (qPoly pn).eval x = 0 ∧
      |x - r.X / 10 ^ r.sx| ≤ 5 / 10 ^ (r.sx + 1) ∧
      |1 / logGR ps x - r.W / 10 ^ r.sw| ≤ 5 / 10 ^ (r.sw + 1) := by
  simp only [logRowOK, Bool.and_eq_true, decide_eq_true_eq] at h
  obtain ⟨⟨⟨⟨⟨⟨⟨⟨ha0, hbD⟩, hsgn⟩, hX1⟩, hX2⟩, hW0⟩, hGE⟩, hW1⟩, hW2⟩ := h
  have hD0 : 0 < D := by omega
  have hDr : (0 : ℝ) < D := by exact_mod_cast hD0
  set l : ℝ := (r.a : ℝ) / D
  set u : ℝ := ((r.a : ℝ) + 1) / D
  have hl0 : 0 < l := div_pos (by exact_mod_cast ha0) hDr
  have hlu : l < u := div_lt_div_of_pos_right (by linarith) hDr
  have hu1 : u ≤ 1 := by
    rw [div_le_one hDr]; exact_mod_cast hbD
  have hlq : (((r.a : ℚ) / D : ℚ) : ℝ) = l := by push_cast; rfl
  have huq : ((((r.a : ℚ) + 1) / D : ℚ) : ℝ) = u := by push_cast; rfl
  -- a zero in `(l, u)`
  have hsgnR : (qPoly pn).eval l * (qPoly pn).eval u < 0 := by
    have := (Rat.cast_lt (K := ℝ)).mpr hsgn
    rw [Rat.cast_mul, Rat.cast_zero, ← qEvalR_cast, ← qEvalR_cast, hlq, huq] at this
    rwa [eval_qPoly, eval_qPoly]
  obtain ⟨x, hx, hx0⟩ : ∃ x ∈ Ioo l u, (qPoly pn).eval x = 0 := by
    have hc : ContinuousOn (fun t => (qPoly pn).eval t) (Icc l u) :=
      (qPoly pn).continuous.continuousOn
    rcases mul_neg_iff.mp hsgnR with ⟨h1, h2⟩ | ⟨h1, h2⟩
    · obtain ⟨x, hx, hx0⟩ := intermediate_value_Ioo' hlu.le hc ⟨h2, h1⟩
      exact ⟨x, hx, hx0⟩
    · obtain ⟨x, hx, hx0⟩ := intermediate_value_Ioo hlu.le hc ⟨h1, h2⟩
      exact ⟨x, hx, hx0⟩
  refine ⟨x, hx.1, hx.2, hx0, ?_, ?_⟩
  · -- the node
    have h10 : (0 : ℝ) < 10 ^ (r.sx + 1) := by positivity
    apply log_abs_le_half_ulp
    · rw [div_le_iff₀ h10]
      have : ((10 * (r.X : ℝ) - 5) * D : ℝ) ≤ r.a * 10 ^ (r.sx + 1) := by exact_mod_cast hX1
      have hl : (r.a : ℝ) = l * D := by simp only [l]; field_simp
      rw [hl] at this
      have h1 : (10 * (r.X : ℝ) - 5) ≤ l * 10 ^ (r.sx + 1) :=
        le_of_mul_le_mul_right (by linarith) hDr
      linarith [mul_le_mul_of_nonneg_right hx.1.le h10.le]
    · rw [le_div_iff₀ h10]
      have : (((r.a : ℝ) + 1) * 10 ^ (r.sx + 1)) ≤ (10 * r.X + 5) * D := by exact_mod_cast hX2
      have hu : ((r.a : ℝ) + 1) = u * D := by simp only [u]; field_simp
      rw [hu] at this
      have h1 : u * 10 ^ (r.sx + 1) ≤ 10 * (r.X : ℝ) + 5 :=
        le_of_mul_le_mul_right (by linarith) hDr
      linarith [mul_le_mul_of_nonneg_right hx.2.le h10.le]
  · -- the weight
    set G0 : ℝ := (logGq ps ((r.a : ℚ) / D) : ℝ)
    set E : ℝ := (logKq ps : ℝ) / D
    have hG0 : logGR ps l = G0 := by rw [← hlq, logGR_cast]
    have hxl : |x - l| ≤ 1 / D := by
      rw [abs_of_pos (by linarith [hx.1]), show (1 : ℝ) / D = u - l by simp only [u, l]; ring]
      linarith [hx.2]
    have hx1 : |x| ≤ 1 := by rw [abs_of_pos (by linarith [hx.1])]; linarith [hx.2]
    have hl1 : |l| ≤ 1 := by rw [abs_of_pos hl0]; linarith
    have hK : (0 : ℝ) ≤ logKq ps := by
      exact_mod_cast logKq_nonneg ps hpos
    have hdiff : |logGR ps x - G0| ≤ E := by
      rw [← hG0]
      calc _ ≤ (logKq ps : ℝ) * |x - l| := logGR_lip ps hpos hx1 hl1
        _ ≤ (logKq ps : ℝ) * (1 / D) := mul_le_mul_of_nonneg_left hxl hK
        _ = E := by simp only [E]; ring
    have hlo : G0 - E ≤ logGR ps x := by linarith [neg_abs_le (logGR ps x - G0)]
    have hhi : logGR ps x ≤ G0 + E := by linarith [le_abs_self (logGR ps x - G0)]
    have cast3 : ((logGq ps ((r.a : ℚ) / D) - logKq ps / D : ℚ) : ℝ) = G0 - E := by
      push_cast; rfl
    have cast4 : ((logGq ps ((r.a : ℚ) / D) + logKq ps / D : ℚ) : ℝ) = G0 + E := by
      push_cast; rfl
    have hGE' : 0 < G0 - E := by rw [← cast3]; exact_mod_cast hGE
    have h1 : (10 * (r.W : ℝ) - 5) * (G0 + E) ≤ 10 ^ (r.sw + 1) := by
      rw [← cast4]; exact_mod_cast hW1
    have h2 : 10 ^ (r.sw + 1) ≤ (10 * (r.W : ℝ) + 5) * (G0 - E) := by
      rw [← cast3]; exact_mod_cast hW2
    have hW5 : (0 : ℝ) ≤ 10 * (r.W : ℝ) - 5 := by
      have : (1 : ℝ) ≤ r.W := by exact_mod_cast hW0
      linarith
    have hGpos : 0 < logGR ps x := by linarith
    have h10 : (0 : ℝ) < 10 ^ (r.sw + 1) := by positivity
    apply log_abs_le_half_ulp
    · rw [div_le_div_iff₀ h10 hGpos, one_mul]
      nlinarith [mul_le_mul_of_nonneg_left hhi hW5]
    · rw [div_le_div_iff₀ hGpos h10, one_mul]
      nlinarith [mul_le_mul_of_nonneg_left hlo (by positivity : (0 : ℝ) ≤ 10 * r.W + 5)]

