/-- The monic polynomials `p_0, …, p_20` with rational coefficients. -/
def logData : List (List ℚ) :=
  logRaw.map fun l => l.map fun c => (c : ℚ) / (l.getLastD 1 : ℚ)

set_option maxRecDepth 100000 in
/-- `p_0, …, p_20` are the monic orthogonal polynomials of `ln(1/x)` on `(0, 1)`. -/
theorem logData_ok : logOKs 0 logData = true := by
  decide +kernel

/-! ### Tables -/

/-- A table `(X, sx, W, sw)` of printed nodes `X/10^{sx}` and weights `W/10^{sw}` is correctly
rounded and complete. -/
def LogTableSpec (n : ℕ) (tab : List (ℕ × ℕ × ℕ × ℕ)) : Prop :=
  (∀ p ∈ tab, ∃ x ∈ logNodes n, |x - p.1 / 10 ^ p.2.1| ≤ 5 / 10 ^ (p.2.1 + 1) ∧
      |logWeight n x - p.2.2.1 / 10 ^ p.2.2.2| ≤ 5 / 10 ^ (p.2.2.2 + 1)) ∧
  ∀ x ∈ logNodes n, ∃ p ∈ tab, |x - p.1 / 10 ^ p.2.1| ≤ 5 / 10 ^ (p.2.1 + 1)

/-- The exact checks for a whole table. -/
def logTableOK (n D : ℕ) (rows : List LogRow) : Bool :=
  decide (n < logData.length) && rows.all (logRowOK (logData.take n) (logData.getD n []) D) &&
    decide (rows.Pairwise fun r s => r.a + 1 ≤ s.a) && decide (rows.length = n)

/-- The printed table of a list of rows. -/
def logTab (rows : List LogRow) : List (ℕ × ℕ × ℕ × ℕ) := rows.map fun r => (r.X, r.sx, r.W, r.sw)

theorem logTableOK_sound {n D : ℕ} {rows : List LogRow} (h : logTableOK n D rows = true) :
    LogTableSpec n (logTab rows) := by
  classical
  simp only [logTableOK, Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true] at h
  obtain ⟨⟨⟨hn, hrows⟩, hpw⟩, hcount⟩ := h
  have hps := logOKs_take logData_ok n
  have hlen : (logData.take n).length = n := by rw [List.length_take]; omega
  have hpn : logOK n (logData.getD n []) = true := by
    simpa using logOKs_getD logData_ok hn
  have hrow : ∀ i : Fin rows.length, ∃ x : ℝ, (rows[i].a : ℝ) / D < x ∧
      x < ((rows[i].a : ℝ) + 1) / D ∧ x ∈ logNodes n ∧
      |x - rows[i].X / 10 ^ rows[i].sx| ≤ 5 / 10 ^ (rows[i].sx + 1) ∧
      |logWeight n x - rows[i].W / 10 ^ rows[i].sw| ≤ 5 / 10 ^ (rows[i].sw + 1) := fun i => by
    obtain ⟨x, hl, hu, hx0, hX, hW⟩ :=
      logRowOK_sound (logOKs_pos hps) (hrows rows[i] (List.getElem_mem _))
    have hmem : x ∈ logNodes n := (mem_logNodes_iff hpn x).mpr hx0
    exact ⟨x, hl, hu, hmem, hX, by rwa [logWeight_eq hps hlen hmem]⟩
  choose xs hxl hxu hxmem hxX hxW using hrow
  have hmono : StrictMono xs := by
    intro i j hij
    have hb : rows[i].a + 1 ≤ rows[j].a := List.pairwise_iff_getElem.mp hpw i j i.2 j.2 hij
    have hD : (0 : ℝ) ≤ D := by positivity
    have : ((rows[i].a : ℝ) + 1) / D ≤ (rows[j].a : ℝ) / D :=
      div_le_div_of_nonneg_right (by exact_mod_cast hb) hD
    linarith [hxu i, hxl j]
  refine ⟨?_, ?_⟩
  · intro p hp
    simp only [logTab, List.mem_map] at hp
    obtain ⟨r, hr, rfl⟩ := hp
    obtain ⟨i, hi, rfl⟩ := List.getElem_of_mem hr
    exact ⟨xs ⟨i, hi⟩, hxmem _, hxX _, hxW _⟩
  · set S : Finset ℝ := univ.image xs
    have hsub : S ⊆ logNodes n := fun t ht => by
      obtain ⟨i, -, rfl⟩ := Finset.mem_image.mp ht
      exact hxmem i
    have hcard : #S = n := by
      rw [Finset.card_image_of_injective _ hmono.injective, Finset.card_univ, Fintype.card_fin,
        hcount]
    have heq : S = logNodes n := eq_of_subset_of_card_le hsub (by rw [card_logNodes, hcard])
    intro t ht
    rw [← heq] at ht
    obtain ⟨i, -, rfl⟩ := Finset.mem_image.mp ht
    refine ⟨(rows[i].X, rows[i].sx, rows[i].W, rows[i].sw), ?_, hxX i⟩
    simp only [logTab, List.mem_map]
    exact ⟨rows[i], List.getElem_mem _, rfl⟩

