import Azurite.AzNat.Mul
import Azurite.AzNat.Square
import Azurite.AzNat.ParseBase

/-!
# Tests for the Toom–Cook ladder: exact division, the evaluation framework, Toom-4, the
unbalanced variants and the dispatcher.
-/

open Azurite Azurite.AzNat

private def P (s : String) : AzNat := (AzNat.parse s).get!
private def Z (s : String) : AzInt := (P s).toAzInt

/-! ## `exactDivOdd` -/

-- single limb
#guard exactDivOdd 3 inv3 (P "123456789") == P "41152263"
-- `2^128 − 1` is divisible by `3` and by `5`
#guard exactDivOdd 3 inv3 (P "340282366920938463463374607431768211455")
  == P "113427455640312821154458202477256070485"
#guard exactDivOdd 5 inv5 (P "340282366920938463463374607431768211455")
  == P "68056473384187692692674921486353642291"
-- a 60-digit multiple of 45, quotient spanning three limbs
#guard exactDivOdd 45 inv45 (P "999999999999999999999999999999999999999999999999999999999990")
  == P "22222222222222222222222222222222222222222222222222222222222"
-- `2^64 + 2 = 9 · 2049638230412172402`: a two-limb input whose quotient fits in one limb
#guard exactDivOdd 9 inv9 (P "18446744073709551618") == P "2049638230412172402"
#guard exactDivOdd 3 inv3 0 == 0

/-! ## The evaluation framework -/

-- Horner: 1 + 2x + 3x² at x = 2 is 17, at x = −2 is 9, at x = −1 is 2; the scaled 1/2 point
-- on the reversed list is 1·4 + 2·2 + 3·1 = 11.
#guard hornerInt64 2 [Z "1", Z "2", Z "3"] == Z "17"
#guard hornerInt64 (-2) [Z "1", Z "2", Z "3"] == Z "9"
#guard hornerInt64 (-1) [Z "1", Z "2", Z "3"] == Z "2"
#guard hornerInt64 2 [Z "1", Z "2", Z "3"].reverse == Z "11"
-- blocks of a 3-limb array cut into 1-limb blocks
#guard blocks #[5, 6, 7] 0 3 1 3 == [Z "5", Z "6", Z "7"]
-- 2-limb blocks of a 5-limb array: the last block is clipped to one limb
#guard blocks #[5, 6, 7, 8, 9] 0 5 2 3
  == [Z "110680464442257309701", Z "147573952589676412935", Z "9"]
-- a signed product through the schoolbook multiplier
#guard signedMulWith 1 (fun x y _ _ => schoolbookMulLimbs x y 0 1 0 1 (by omega) (by omega))
    (-(Z "6")) (Z "7") == -(Z "42")
-- exact division of a negative multiple
#guard AzInt.exactDivOdd 3 inv3 (-(Z "123456789")) == -(Z "41152263")
-- assembly: 1 + 2·β + 3·β²
#guard assemble 1 [P "1", P "2", P "3"] == ofLimbs #[1, 2, 3]

/-! ## Toom-4 multiplication -/

-- Every level forced: Toom-4 down to 4 limbs, Toom-3 down to 3, Karatsuba down to 2.
private def t4 (a b : AzNat) : AzNat := mulToomCook4 4 3 2 a b

-- 5-limb operands (the awkward case `3k > len`: blocks of 2, 2, 1, 0 limbs)
#guard t4 (P "1208925819614629174706176000000000000000000000000000000000000000000000000000000001")
    (P "9999999999999999999999999999999999999999999999999999999999999999999999999999999")
  == P "1208925819614629174706176000000000000000000000000000000000000000000000000000000001"
    * P "9999999999999999999999999999999999999999999999999999999999999999999999999999999"
-- 8-limb operands, one of them `2^512 − 1`
#guard t4 (P "13407807929942597099574024998205846127479365820592393377723561443721764030073546976801874298166903427690031858186486050853753882811946569946433649006084095")
    (P "1234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890")
  == P "13407807929942597099574024998205846127479365820592393377723561443721764030073546976801874298166903427690031858186486050853753882811946569946433649006084095"
    * P "1234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890"
-- unequal sizes are padded; a zero operand
#guard t4 (P "340282366920938463463374607431768211455") (P "18446744073709551616")
  == P "340282366920938463463374607431768211455" * P "18446744073709551616"
#guard t4 (P "340282366920938463463374607431768211455000000000000000000000000000000000000000000000") 0 == 0
-- 17 limbs: two levels of Toom-4 (17 → 5 → Toom-3)
#guard t4 (P "")
    (P "")
  == P ""
    * P ""

/-! ## Toom-4 squaring -/

private def s4 (a : AzNat) : AzNat := squareToomCook4 4 3 2 a

#guard s4 (P "1208925819614629174706176000000000000000000000000000000000000000000000000000000001")
  == P "1208925819614629174706176000000000000000000000000000000000000000000000000000000001"
    * P "1208925819614629174706176000000000000000000000000000000000000000000000000000000001"
#guard s4 (P "13407807929942597099574024998205846127479365820592393377723561443721764030073546976801874298166903427690031858186486050853753882811946569946433649006084095")
  == P "13407807929942597099574024998205846127479365820592393377723561443721764030073546976801874298166903427690031858186486050853753882811946569946433649006084095"
    * P "13407807929942597099574024998205846127479365820592393377723561443721764030073546976801874298166903427690031858186486050853753882811946569946433649006084095"
#guard s4 (P "")
  == P ""
    * P ""
#guard s4 0 == 0

/-! ## Unbalanced variants and the dispatcher -/

private def bal : BalancedMul := balancedMul { schoolbook := 2, toomCook3 := 3, toomCook4 := 4 }

private def u32 (a b : AzNat) : AzNat :=
  ofLimbs (toom32MulLimbs bal a.limbs b.limbs 0 a.limbs.size 0 b.limbs.size (by simp) (by simp))
private def u42 (a b : AzNat) : AzNat :=
  ofLimbs (toom42MulLimbs bal a.limbs b.limbs 0 a.limbs.size 0 b.limbs.size (by simp) (by simp))
private def uch (a b : AzNat) : AzNat :=
  ofLimbs (mulChunksLimbs bal a.limbs b.limbs 0 a.limbs.size 0 b.limbs.size (by simp) (by simp))

private def big (n : Nat) : AzNat := P (String.ofList (List.replicate n '7'))   -- n digits of 7

-- ratios 3:2 (12 × 8 limbs), 2:1 (16 × 8), and a big ratio (40 × 8)
#guard u32 (big 230) (big 150) == big 230 * big 150
#guard u42 (big 300) (big 150) == big 300 * big 150
#guard uch (big 760) (big 150) == big 760 * big 150
#guard uch (big 760) 0 == 0
-- the dispatcher with tiny thresholds exercises every branch
private def th : MulThresholds := { schoolbook := 2, toomCook3 := 3, toomCook4 := 4, unbalanced := 2 }
private def dm (a b : AzNat) : AzNat :=
  ofLimbs (mulLimbsWith th a.limbs b.limbs 0 a.limbs.size 0 b.limbs.size (by simp) (by simp))
#guard dm (big 230) (big 150) == big 230 * big 150
#guard dm (big 150) (big 230) == big 230 * big 150
#guard dm (big 300) (big 150) == big 300 * big 150
#guard dm (big 760) (big 150) == big 760 * big 150
#guard dm (big 160) (big 150) == big 160 * big 150
#guard dm (big 5) (big 760) == big 760 * big 5
#guard dm (big 100) 0 == 0
